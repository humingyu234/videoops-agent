{
  "name": "suzao-ai",
  "version": "0.1.0",
  "private": true,
  "author": "Spacetime Ripple",
  "description": "素造智能体 Electron 用户端桌面薄壳",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "build:dev": "cross-env ELECTRON_BUILD_MODE=development node --experimental-strip-types scripts/build.ts",
    "build:package": "cross-env ELECTRON_BUILD_MODE=production node --experimental-strip-types scripts/build.ts",
    "dev": "pnpm build:dev && cross-env NODE_ENV=development electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "pack": "pnpm build:package && electron-builder --dir --publish never",
    "dist:win": "pnpm build:package && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "pnpm build:package && electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@types/node": "26.1.2",
    "cross-env": "10.1.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "png2icons": "2.0.1",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
