{
  "contractVersion": "discovery-runninghub-single-execution-1",
  "forbiddenFields": [
    "self_hosted_comfyui",
    "runninghub_workflow",
    "runninghub_ai_app",
    "providerKind",
    "executionMode",
    "executionPlanId",
    "templateVersionId",
    "workflowId",
    "webAppId",
    "nodeId",
    "runningHubTaskId"
  ],
  "forbiddenConcepts": [
    "provider selection",
    "version selection",
    "execution plan selection",
    "automatic routing",
    "automatic failover",
    "fallback",
    "same-order manual replay"
  ],
  "userOrderRequest": {
    "allowedFields": ["templateId", "schemaHash", "inputs"],
    "idempotencyKey": "Idempotency-Key HTTP header"
  },
  "taskContract": {
    "systemTaskTypes": ["workflow_template_generate", "workflow_template_test"],
    "userVisibleTaskTypes": ["workflow_template_generate"],
    "resourceTypes": ["workflow_order", "workflow_template"],
    "freePolicyVersion": "workflow-free-1",
    "statusStageMatrix": {
      "pending": ["waiting_for_dispatch"],
      "queued": ["waiting_for_dispatch"],
      "running": [
        "preparing_inputs",
        "submitting_to_provider",
        "confirming_provider_acceptance",
        "provider_processing",
        "processing_results"
      ],
      "success": ["completed"],
      "failed": ["failed"],
      "cancelled": ["cancelled"]
    },
    "asyncFailureCodes": [
      "WORKFLOW_SUBMISSION_UNKNOWN",
      "WORKFLOW_EXECUTION_FAILED",
      "WORKFLOW_OUTPUT_INVALID",
      "WORKFLOW_CONFIG_CHANGED"
    ]
  },
  "userErrorCodes": {
    "46501": "WORKFLOW_TEMPLATE_UNAVAILABLE",
    "46502": "WORKFLOW_CREATION_CONFIG_STALE",
    "46503": "WORKFLOW_EXECUTION_CONFIG_UNAVAILABLE",
    "46505": "WORKFLOW_INPUT_INVALID",
    "46506": "WORKFLOW_INPUT_ASSET_INVALID",
    "46507": "WORKFLOW_ORDER_IDEMPOTENCY_CONFLICT",
    "46509": "WORKFLOW_ORDER_CANCEL_CONFLICT",
    "46518": "WORKFLOW_ORDER_NO_LONGER_REMAKABLE"
  }
}
